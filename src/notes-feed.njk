---
permalink: "/notes/feed.xml"
eleventyExcludeFromCollections: true
---
{#- Atom feed for Notes. Hand-written rather than the plugin's ready-made feed so that
    lead images and audio (which live in front matter, not in the note body) are included. -#}
{%- set base = site.url + "/" -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>Mikael Viima — Notes</title>
  <subtitle>A diary kept in public.</subtitle>
  <link href="{{ site.url }}/notes/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/notes/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/notes/</id>
  <updated>{{ collections.notes | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <author>
    <name>Mikael Viima</name>
    <uri>{{ site.url }}/</uri>
  </author>
  {%- for note in collections.notes %}
  {%- set noteUrl = site.url + note.url %}
  {%- set noteHtml %}
    {%- if note.data.image %}<p><img src="{{ note.data.image }}" alt="{{ note.data.image_alt or '' }}"{% if note.data.image_width %} width="{{ note.data.image_width }}" height="{{ note.data.image_height }}"{% endif %}></p>{% endif %}
    {%- if note.data.image_caption %}<p><em>{{ note.data.image_caption }}</em></p>{% endif %}
    {%- if note.data.audio %}<p><a href="{{ note.data.audio }}">Listen{% if note.data.audio_duration %} ({{ note.data.audio_duration }}){% endif %}</a></p>{% endif %}
    {{- note.content | safe -}}
  {%- endset %}
  <entry>
    <title>{{ note.data.title }}</title>
    <link href="{{ noteUrl }}" rel="alternate" type="text/html"/>
    {%- if note.data.audio %}
    <link href="{{ site.url }}{{ note.data.audio }}" rel="enclosure" type="audio/mpeg"/>
    {%- endif %}
    <id>{{ noteUrl }}</id>
    <published>{{ note.date | dateToRfc3339 }}</published>
    <updated>{{ note.date | dateToRfc3339 }}</updated>
    {%- if note.data.summary %}
    <summary>{{ note.data.summary }}</summary>
    {%- endif %}
    <content type="html">{{ noteHtml | htmlToAbsoluteUrls(base) }}</content>
  </entry>
  {%- endfor %}
</feed>
