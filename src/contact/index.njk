---
layout: layouts/base.njk
seo_title: "Contact — Mikael Viima"
meta_description: "Contact Mikael Viima for publishing, translation rights, representation, interviews, readings and festival invitations."
og_type: "website"
---
<section class="section">
  <div class="wrap">
    <h1 class="content-section__heading">Contact</h1>
    <div class="content-section__body">
      <p>
        For <strong>publishing, translation rights, representation, interviews,
        readings, festival invitations and professional enquiries</strong>:
      </p>
    </div>
    <p class="contact-email"><a class="text-link" href="mailto:{{ author.contact_email }}">{{ author.contact_email }}</a></p>
    <p class="content-section__body">
      For rights to individual Finnish editions, use the appropriate publisher/rights
      contact once confirmed.
    </p>

    <div class="contact-block" style="margin-top: var(--space-4);">
      <p class="label content-section__label">Social</p>
      {% include "partials/social-links.njk" %}
      {%- if author.optional_social_url %}
      <p>Other: <a class="text-link" href="{{ author.optional_social_url }}">{{ author.optional_social_url }}</a></p>
      {%- endif %}
    </div>
  </div>
</section>
