---
layout: layouts/base.njk
seo_title: "Contact — Mikael Viima"
meta_description: "Contact Mikael Viima for publishing, translation rights, representation, interviews, readings and festival invitations."
og_type: "website"
---
<section class="section">
  <div class="wrap">
    <h1 class="content-section__heading">Contact</h1>
    <div class="content-section__body">
      <p>
        For <strong>publishing, translation rights, representation, interviews,
        readings, festival invitations and professional enquiries</strong>:
      </p>
    </div>
    <p class="contact-email"><a class="text-link" href="mailto:{{ author.contact_email }}">{{ author.contact_email }}</a></p>
    <p class="content-section__body">
      For rights to individual Finnish editions, use the appropriate publisher/rights
      contact once confirmed.
    </p>

    <div class="contact-block" style="margin-top: var(--space-4);">
      <p class="label content-section__label">Social</p>
      {#- Icons are hand-drawn inline SVG (no third-party files), hidden from
          screen readers; the visible label is the link's accessible name. #}
      <ul class="social-links">
        <li>
          <a class="social-link" href="{{ author.instagram_url }}">
            <svg class="social-link__icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>
            </svg>
            <span>Instagram</span>
          </a>
        </li>
        {%- if author.flickr_url %}
        <li>
          <a class="social-link" href="{{ author.flickr_url }}">
            <svg class="social-link__icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
              <circle cx="6" cy="12" r="5.5" fill="currentColor"/>
              <circle cx="18" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8"/>
            </svg>
            <span>Flickr</span>
          </a>
        </li>
        {%- endif %}
      </ul>
      {%- if author.optional_social_url %}
      <p>Other: <a class="text-link" href="{{ author.optional_social_url }}">{{ author.optional_social_url }}</a></p>
      {%- endif %}
    </div>
  </div>
</section>
