<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__col">
      <p class="site-footer__name">MIKAEL VIIMA</p>
      <p class="site-footer__descriptor">{{ author.short_descriptor }}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {%- for item in site.nav_footer %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        {%- if author.instagram_url and not author.instagram_url.startsWith("[") %}
        <li><a href="{{ author.instagram_url }}">Instagram</a></li>
        {%- endif %}
        {%- if author.flickr_url %}
        <li><a href="{{ author.flickr_url }}">Flickr</a></li>
        {%- endif %}
      </ul>
    </nav>

    <p class="site-footer__legal">
      &copy; {{ currentYear }} {{ author.legal_name }}. All rights reserved.
    </p>
  </div>
</footer>
