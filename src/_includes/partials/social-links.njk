{#- Instagram + Flickr as icon + name links. Icons are hand-drawn inline SVG
    (no third-party files), hidden from screen readers; the visible label is
    the link's accessible name. Used on Contact and at the end of /notes/. #}
<ul class="social-links">
  <li>
    <a class="social-link" href="{{ author.instagram_url }}">
      <svg class="social-link__icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/>
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
        <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>
      </svg>
      <span>Instagram</span>
    </a>
  </li>
  {%- if author.flickr_url %}
  <li>
    <a class="social-link" href="{{ author.flickr_url }}">
      <svg class="social-link__icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
        <circle cx="6" cy="12" r="5.5" fill="currentColor"/>
        <circle cx="18" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8"/>
      </svg>
      <span>Flickr</span>
    </a>
  </li>
  {%- endif %}
</ul>
