{% macro portrait(person) %}
{%- if person.image %}
<div class="portrait-frame">
  <img
    class="portrait-frame__image"
    src="{{ person.image }}"
    alt="{{ person.alt }}"
    width="{{ person.width }}"
    height="{{ person.height }}"
    loading="lazy"
  >
</div>
{%- else %}
<div class="portrait-placeholder">
  <p class="portrait-placeholder__text">{{ person.alt }} — portrait pending</p>
</div>
{%- endif %}
<p class="photo-credit">
  {%- if person.photographer_url -%}
    Photo: <a class="text-link" href="{{ person.photographer_url }}" target="_blank" rel="noopener">{{ person.photographer_name }}</a>{% if person.year %}, {{ person.year }}{% endif %}
  {%- elif person.photographer_name -%}
    Photo: {{ person.photographer_name }}{% if person.year %}, {{ person.year }}{% endif %}
  {%- else -%}
    {{ person.credit }}
  {%- endif -%}
</p>
{% endmacro %}
