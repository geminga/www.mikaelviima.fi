<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__name" href="/">MIKAEL VIIMA</a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">Menu</span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav class="site-nav" id="primary-nav" aria-label="Primary">
      <ul>
        {%- for item in site.nav_primary %}
        {%- if not item.requires_collection or collections[item.requires_collection].length %}
        <li><a href="{{ item.url }}"{% if page.url == item.url or (page.url and item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
